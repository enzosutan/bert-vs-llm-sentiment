# ── OpenAI API Key ────────────────────────────────────────────────────────────
# Required for notebooks/llm_zero_shot.ipynb (GPT-4o-mini zero-shot pipeline)
# Get your own key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── SenticNet API Keys ────────────────────────────────────────────────────────
# Required for notebooks/sentic_api_comparison.ipynb and cross-domain synthesis.
# Endpoint format: https://sentic.net/api/en/{KEY}.py?text={TEXT}
#
# NOTE ON SHARED/DEFAULT KEYS:
# The keys below are default/shared keys extracted from the SenticNet SDK.
# Because they are public, requests using them are heavily rate-limited, and
# modern cloud/automation IP ranges may trigger Web Application Firewall (WAF)
# security blocks (Status 465).
# If you experience WAF blocks, please sign up for a free developer key at:
# https://sentic.net/api
#
# Primary keys used by the ensemble comparisons:
SENTIC_CONCEPT_PARSING_KEY=your_key_here
SENTIC_SUBJECTIVITY_KEY=your_key_here
SENTIC_POLARITY_KEY=your_key_here            # (*) primary sentiment signal
SENTIC_INTENSITY_KEY=your_key_here
SENTIC_EMOTION_KEY=your_key_here       # (*) emotion breakdown
SENTIC_ASPECT_KEY=your_key_here
SENTIC_PERSONALITY_KEY=your_key_here
SENTIC_SARCASM_KEY=your_key_here         # (*) sarcasm detection
SENTIC_DEPRESSION_KEY=your_key_here
SENTIC_TOXICITY_KEY=your_key_here
SENTIC_ENGAGEMENT_KEY=your_key_here
SENTIC_WELLBEING_KEY=your_key_here
SENTIC_ENSEMBLE_KEY=your_key_here          # (*) full ensemble (all fields combined)
